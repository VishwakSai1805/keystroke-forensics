# Copy to .env (never commit). Public values only go to the client build.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon or publishable key>
# Server-side only (Supabase Edge Function secrets / local dev server):
RUN_TOKEN_SECRET=<32+ random bytes, hex>
ANTHROPIC_API_KEY=<optional, enables the Claude coach>
GEMINI_API_KEY=<optional, enables the Gemini coach; used when no Anthropic key>
GEMINI_MODEL=<optional, defaults to gemini-3.5-flash-lite>
ALLOWED_ORIGINS=https://<your-vercel-domain>
