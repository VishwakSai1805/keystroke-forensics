{
  "name": "keystroke-forensics",
  "version": "1.0.0",
  "private": true,
  "description": "Real-time typing performance analyzer with a server-verified leaderboard. Vanilla JS and React front-ends over one shared core.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node tools/serve.mjs",
    "dev:react": "npm run dev -w react",
    "build": "npm run build:vanilla && npm run build:react",
    "build:vanilla": "node tools/build-vanilla.mjs",
    "build:react": "npm run build -w react",
    "sync:supabase": "node tools/sync-supabase.mjs",
    "fonts": "node tools/fetch-fonts.mjs",
    "icons": "node tools/make-icons.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deploy": "node tools/deploy.mjs",
    "start": "node server/app.mjs",
    "test:e2e:prod": "playwright test -c playwright.prod.config.js",
    "pg:dev": "node tools/pg-dev.mjs"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@electric-sql/pglite": "^0.5.13",
    "@electric-sql/pglite-socket": "^0.2.16",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/opendyslexic": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "vitest": "^5.0.5"
  },
  "workspaces": [
    "react"
  ],
  "dependencies": {
    "pg": "^8.23.1"
  }
}
